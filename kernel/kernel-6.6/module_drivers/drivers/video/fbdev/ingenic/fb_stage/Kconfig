menuconfig FB_INGENIC_STAGE
	tristate "Ingenic Framebuffer Driver for stage"
	depends on FB_INGENIC
	select FB_INGENIC_DISPLAYS_STAGE
	select FB_CFB_FILLRECT
	select FB_CFB_COPYAREA
	select FB_CFB_IMAGEBLIT
	help
	  Framebuffer support for the Version 12 DPU SoC.
config HW_COMPOSER_V4L2_M2M
	bool "support composer v4l2mem device"
	depends on FB_INGENIC_STAGE
	select V4L2_MEM2MEM_DEV
	select VIDEOBUF2_DMA_CONTIG_INGENIC
	default n
	help
		This config composer use for v4l2 device
config FB_USING_CACHABLE
	bool "using cacheable framebuffers, will flush cache when call pan_display."
	depends on FB_INGENIC_STAGE
	default n
	help
		Using Cacheable mmap to userspace.
config FB_INGENIC_PAN_VSYNC_GATE
	bool "wait for a real vsync event before applying a pan_display frame switch"
	depends on FB_INGENIC_STAGE
	default n
	help
		DISPLAY-V1 prototype (NebulaOS display hardware analysis mission,
		2026-08-01): dpu_ctrl_rdma_change(), the function FBIOPAN_DISPLAY
		calls to switch the active scanout frame, never waits for the
		in-flight frame's scan-out to complete before writing the new
		frame's address - this can tear if userspace pans faster than the
		display refreshes. When enabled, ingenicfb_pan_display() waits
		(bounded, with a safe immediate-update fallback on timeout) for
		the next real vsync event before applying the switch, reusing the
		same vsync waitqueue and IRQ event that already drives
		FBIO_WAITFORVSYNC. Disabled by default - never enable this for a
		production build until live hardware testing confirms it does not
		regress the working display path (see
		docs/NEBULAOS_DISPLAY_LIVE_QUALIFICATION_PLAN.md).

