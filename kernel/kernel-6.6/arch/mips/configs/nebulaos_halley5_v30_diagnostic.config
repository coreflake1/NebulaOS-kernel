# NebulaOS diagnostic kernel profile: merged after nebulaos_halley5_v30_defconfig
# when the firmware manifest selects the diagnostic KERNEL_CONFIG_PROFILE.
# Never shipped as production. Latency figures from this kernel are upper
# bounds (the irqsoff/preempt tracers hook every irq/preempt toggle).
# LOCKDEP/PROVE_LOCKING are deliberately excluded: several MiB of static
# tables on a ~208 MiB system, and they distort the latency this profile
# exists to measure.
CONFIG_LOCALVERSION="-diag"
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PREEMPT_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_OSNOISE_TRACER=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_HWLAT_TRACER=y
CONFIG_SCHEDSTATS=y
CONFIG_PSI=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_USB_DWC2_TRACK_MISSED_SOFS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PINCTRL_DUMP=y
CONFIG_BLK_DEBUG_FS=y
